#Create file .env for npm start or npm run prod
NODE_ENV=production
PORT=8002
DB_HOST="host"
DB_DATABASE="dbname" 
DB_PORT=5432 
DB_SSL=true 
DB_USER="user" 
DB_PASSWORD="password" 
DB_SCHEMA="variamos_laboratory"
# "mock" simulates the results; "semantic_translator" runs real solvers through the /query endpoint below
LAB_REASONING_GATEWAY=mock
LAB_SEMANTIC_TRANSLATOR_URL=
# Only "mock" exists until the run notification is agreed
LAB_NOTIFICATION_GATEWAY=mock

#Create file .env.development for npm run dev
NODE_ENV=development
PORT=8002
DB_HOST="host"
DB_DATABASE="dbname" 
DB_PORT=5432 
DB_SSL=true 
DB_USER="user" 
DB_PASSWORD="password" 